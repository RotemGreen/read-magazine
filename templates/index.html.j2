<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site_title }}</title>
  <link rel="stylesheet" href="static/style.css">
</head>
<body>
  <div class="wrap">
    <header class="masthead">
      <h1>{{ site_title }}</h1>
      <p>{{ site_tagline }}</p>
    </header>

    {% if issues %}
    <ul class="issue-list">
      {% for issue in issues %}
      <li>
        <a class="issue-card" href="issues/{{ issue.id }}.html">
          <p class="issue-number">Issue #{{ issue.number }}</p>
          <p class="issue-date">{{ issue.date }}</p>
        </a>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="empty-state">The first issue is on its way.</p>
    {% endif %}
  </div>
</body>
</html>
