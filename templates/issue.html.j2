<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Issue #{{ issue.number }} — {{ site_title }}</title>
  <link rel="stylesheet" href="../static/style.css">
</head>
<body>
  <div class="wrap">
    <a class="back-link" href="../index.html">&larr; all issues</a>

    <header class="issue-header">
      <p class="issue-number">Issue #{{ issue.number }}</p>
      <p class="issue-date">{{ issue.date }}</p>
    </header>

    {% for pick in issue.picks %}
    <article class="pick">
      <span class="tag {{ pick.tag }}">{{ pick.tag.replace('-', ' ') }}</span>
      <h2><a href="{{ pick.link }}" target="_blank" rel="noopener">{{ pick.title }}</a></h2>
      <p class="blurb">{{ pick.blurb }}</p>
      <p class="source">{{ pick.source }}</p>
    </article>
    {% endfor %}
  </div>
</body>
</html>
